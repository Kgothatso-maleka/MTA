      {
        "id": "a",
        "text": "It is strongly typed, object-oriented and runs on Salesforce servers"
      },
      {
        "id": "b",
        "text": "It runs in the user's browser"
      },
      {
        "id": "c",
        "text": "It is a weakly typed scripting language"
      },
      {
        "id": "d",
        "text": "It only runs inside flows"
