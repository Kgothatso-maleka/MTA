    "type": "single",
    "stem": "What is the index of the first element in an Apex List?",
    "options": [
      {
        "id": "a",
        "text": "0"
      },
      {
        "id": "b",
        "text": "1"
      },
      {
        "id": "c",
        "text": "-1"
      },
      {
        "id": "d",
        "text": "It depends on the type"
